@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
	<div class="panel">
		<div class="line">SKYNEET  @ClockText  |  SCRAP @ScrapText</div>
		<div class="line">NNN @NodeText  LOUD @LoudText  @SancientText</div>
		<div class="line">OWNER @OwnerText  @EndText</div>
		<div class="hint">E: plant NNN / raise fort   extract: hold the dark pad</div>
	</div>
</root>

<style>
root {
	position: absolute;
	top: 24px;
	left: 24px;
	font-family: Poppins, sans-serif;
	color: white;
	pointer-events: none;
}
.panel {
	background-color: #000000aa;
	padding: 12px 16px;
	border-radius: 6px;
}
.line { font-size: 18px; }
.hint { font-size: 13px; color: #c8c8c8; margin-top: 6px; }
</style>
